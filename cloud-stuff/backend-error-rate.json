{
  "id": "/subscriptions/bff82f66-027a-4464-a242-3e971760bb2e/resourceGroups/team_buldozer/providers/microsoft.insights/metricAlerts/backend-error-rate",
  "name": "backend-error-rate",
  "type": "Microsoft.Insights/metricAlerts",
  "location": "global",
  "tags": {
    "SummerPractice": "Azure"
  },
  "properties": {
    "description": "",
    "severity": 3,
    "enabled": true,
    "scopes": [
      "/subscriptions/bff82f66-027a-4464-a242-3e971760bb2e/resourceGroups/team_buldozer/providers/Microsoft.App/containerApps/team-buldozer-backend"
    ],
    "evaluationFrequency": "PT1M",
    "windowSize": "PT5M",
